# GEMINI_API_KEY: Required for Gemini AI API calls (the "brain" — chat + function calling).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WEBHOOK_URL: URL for Android automation triggers (MacroDroid/Tasker)
WEBHOOK_URL="https://your-webhook-endpoint.com"

# FISH_AUDIO_API_KEY: Required for the cloned Ultron voice (Fish Audio TTS).
# Get one at https://fish.audio — without it, falls back to browser TTS.
FISH_AUDIO_API_KEY=""

# FISH_VOICE_REFERENCE_ID: which Fish Audio voice model to speak with.
# Defaults to the Ultron voice model id if left blank.
FISH_VOICE_REFERENCE_ID="a0739d5765be4143a15dc37f91f19163"

# DEFAULT_CITY: used for weather queries when you don't name a city
# ("what's the weather?" vs "what's the weather in Tokyo?")
DEFAULT_CITY="Kanpur"

# NEWSAPI_KEY: from newsapi.org/register (free dev tier — non-commercial,
# rate-limited). Without it, get_news answers honestly that it's not wired up.
NEWSAPI_KEY=""

# DEFAULT_NEWS_COUNTRY: 2-letter country code for general "what's in the
# news" with no topic named.
DEFAULT_NEWS_COUNTRY="in"

# GROQ_API_KEY: from console.groq.com (free, no card needed). Runs Llama on
# Groq's LPU hardware — much faster token generation than Gemini Flash.
# The moment this is set, Groq becomes the primary brain automatically
# (Gemini becomes its fallback if GEMINI_API_KEY is also set).
GROQ_API_KEY=""

# BRAIN_PROVIDER: "groq" or "gemini" — force which one goes first.
# Leave blank to auto-pick: Groq if GROQ_API_KEY is set, else Gemini.
BRAIN_PROVIDER=""
